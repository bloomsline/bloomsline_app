# Production web build config. Committed (these are PUBLIC identifiers only: the
# API base + OAuth *client ids*, never secrets). On the Scalingo build the
# gitignored `.env` is absent, so ONLY this file is loaded → a clean prod config.
# Dev flags are explicitly emptied so they can never leak into production.
#
# EXPO_PUBLIC_* values are INLINED AT BUILD TIME, so changing the API base needs
# a rebuild, not just an env change on the running app.
#
# The care backend. `platform.bloomsline.com` was here until 2026-08-06 and has
# never resolved (NXDOMAIN) — production only worked because Scalingo sets
# EXPO_PUBLIC_API_URL on `bloomsline-app`, which wins over this file. That made
# this line a trap rather than a default: removing the override would have built
# the app against a host that does not exist, with nothing failing at build time
# to say so. It now matches what the platform actually sets.
EXPO_PUBLIC_API_URL=https://www.bloomsline.com
EXPO_PUBLIC_MOCK_AUTH=
EXPO_PUBLIC_FORCE_CARE_HUB=
EXPO_PUBLIC_FORCE_FLOW=

# OAuth client ids (public). Social sign-in also needs this app's own origin,
# https://app.bloomsline.com, registered as a redirect URI in Google/Azure
# (the app does on-device PKCE and posts the id_token to the backend, so the
# redirect target is this origin, NOT a backend callback path). Email sign-in
# works without any of that.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=261792358409-d93i6v45f68nec5l0hk9m2oqmbu0t1im.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=261792358409-fr16ma4rpgemtc4mv8eb961mtou4m1er.apps.googleusercontent.com
# There is deliberately NO Android client id. One was created and configured
# correctly (package com.bloomsline.app + the keystore's SHA-1), and Google
# answered the app's request with `Error 400: invalid_request` every time, before
# the consent screen. Android signs in through our own server instead, which uses
# the WEB client above and its secret: see `src/auth/google-web.ts` and
# `api/mobile/auth/google/web` on the care app. Nothing here is needed for it.
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=b6d92208-e461-45fe-a9b0-3bc373f2a665
# `common`, NOT our directory GUID. Pinning the tenant sends the authorize
# request to our own directory's endpoint, and Microsoft then requires the user
# to exist THERE: a personal account (hotmail, outlook, live) is refused with
# AADSTS50020 no matter how the app registration's account types are set.
# The backend does not need it pinned — its issuer is `common` and
# microsoftEmailTrusted() admits the MSA consumer tenant on a verified `tid`.
EXPO_PUBLIC_MICROSOFT_TENANT=common

# Sign in with Apple on the web and on Android, through Apple's OAuth flow
# (the iOS sheet needs none of this and ignores the flag). Requires
# APPLE_SERVICES_ID on the care app; without it the start route is a 404 and
# the button would walk someone into an error at Apple.
EXPO_PUBLIC_APPLE_WEB_SIGNIN=1

# PostHog (statistics). The project's PUBLIC key, the SAME project the website
# uses, so the app and the site are one set of numbers rather than two. It is
# not a secret: a public key can only write events, and it is inlined into every
# shipped bundle by design.
#
# It changes nothing on its own. The app builds the SDK only after someone
# answers the question in the app (src/analytics), so an empty key here would
# mean no analytics AND no question. With it set, the question is asked once
# per device and nothing is sent until it is answered.
EXPO_PUBLIC_POSTHOG_KEY=phc_HXmmDQEZSyxtm2AmkiKF1J4fC9JXigmXgZ02xpsWtDI
