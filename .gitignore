# dependencies
# No trailing slash. `node_modules/` matches a directory only, so a SYMLINK
# named node_modules is not ignored by it and can be committed (this happened
# in #37). Without the slash, both forms are ignored.
node_modules

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# metro
.metro-health-check*

# secrets / local env
.env
.env.local

# macOS
.DS_Store

# logs
npm-debug.*
yarn-debug.*
yarn-error.*
